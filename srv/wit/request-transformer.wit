package aestus:request-transformer@1.0.0;

interface common-types {
    use aestus:plugin-types/response-types@1.0.0.{plugin-context};

    record header {
        name: string,
        value: list<u8>,
    }

    record transform-output {
        headers: list<header>,
        body: list<u8>,
        /// 与最终 header/body 同属一次 attempt 的权威响应阶段上下文。
        plugin-context: plugin-context,
    }

    record transform-error {
        /// 可安全返回给调用方的稳定错误码。请求插件返回该声明错误表示输入被主动拒绝，
        /// 宿主会生成 HTTP 400；WASM trap、ABI 失败和非法输出不使用此类型。
        code: string,
        /// 可安全返回给调用方的错误说明，不得包含账号凭证或其他上游敏感信息。
        message: string,
    }
}

interface gpt-types {
    use common-types.{header};

    record account-resource {
        access-token: string,
        chatgpt-account-id: option<string>,
        chatgpt-account-is-fedramp: bool,
    }

    record transform-input {
        /// 当前 attempt 的 OAuth 账号凭证投影。官方 API Key 由宿主直接执行 Provider
        /// 原生流程，不会进入请求插件，也无法通过该 ABI 表达。
        account: account-resource,
        headers: list<header>,
        body: list<u8>,
    }
}

interface claude-types {
    use common-types.{header};

    record account-resource {
        access-token: string,
        account-uuid: string,
    }

    record transform-input {
        /// 当前 attempt 的 OAuth 账号凭证投影。官方 API Key 由宿主直接执行 Provider
        /// 原生流程，不会进入请求插件，也无法通过该 ABI 表达。
        account: account-resource,
        headers: list<header>,
        body: list<u8>,
    }
}

world gpt-request-transformer {
    use common-types.{transform-output, transform-error};
    use gpt-types.{transform-input};
    export transform: func(input: transform-input) -> result<transform-output, transform-error>;
}

world claude-request-transformer {
    use common-types.{transform-output, transform-error};
    use claude-types.{transform-input};
    export transform: func(input: transform-input) -> result<transform-output, transform-error>;
}
