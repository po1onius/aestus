# Docker Compose 环境变量模板。
# 使用前复制为 deploy/.env，并将所有密码、密钥等示例值替换为生产环境安全值。
# DATABASE_URL 由 compose.yml 根据下列 PostgreSQL 参数自动拼接，无需单独配置。

# ==================== PostgreSQL ====================

# Aestus 使用的数据库名称；同时用于初始化 PostgreSQL 和拼接网关数据库连接串。
POSTGRES_DB=aestus_gateway
# PostgreSQL 登录用户名；同时用于数据库健康检查和网关连接。
POSTGRES_USER=aestus
# PostgreSQL 登录密码。生产环境必须替换为高强度随机密码。
POSTGRES_PASSWORD=aestus

# ==================== Redis ====================

# Redis 完整连接地址，用于资源运行时状态、会话粘性和邮件验证码等临时数据。
# Compose 网络内应使用服务名 redis，不要改为 127.0.0.1；末尾 /0 表示使用 0 号数据库。
REDIS_URL=redis://redis:6379/0

# ==================== ClickHouse ====================

# ClickHouse HTTP 接口地址，用于写入和查询网关请求日志。
# Compose 网络内应使用服务名 clickhouse；8123 是 HTTP 端口，不是原生协议的 9000 端口。
CLICKHOUSE_URL=http://clickhouse:8123
# ClickHouse 数据库名称，同时传给 ClickHouse 容器进行初始化。
CLICKHOUSE_DATABASE=default
# ClickHouse 登录用户名，同时传给 ClickHouse 容器进行初始化。
CLICKHOUSE_USER=default
# ClickHouse 登录密码，不能为空；生产环境必须替换为高强度随机密码。
CLICKHOUSE_PASSWORD=change-me-clickhouse-password
# 请求日志表名。默认初始化 SQL 只创建 gateway_request_logs，修改时必须同步建表脚本或预先建表。
AESTUS_REQUEST_LOG_TABLE=gateway_request_logs

# ==================== Dashboard 鉴权与初始管理员 ====================

# Dashboard JWT 的 HS256 签名密钥，不能为空；生产环境必须使用足够长的高熵随机字符串。
# 修改该值会使此前签发的所有 Dashboard 登录令牌失效。
AESTUS_JWT_SECRET=change-me-to-a-long-random-secret
# Dashboard JWT 有效期，单位为秒；604800 秒等于 7 天。
AESTUS_JWT_TTL_SECONDS=604800

# 首次连接全新数据库时创建的管理员用户名；管理员已存在时不会覆盖现有资料。
AESTUS_ADMIN_USERNAME=admin
# 首次连接全新数据库时创建的管理员邮箱；同时作为管理员账号的唯一登录邮箱。
AESTUS_ADMIN_EMAIL=admin@example.com
# 初始管理员密码，不能为空；生产环境必须替换，且仅在管理员尚不存在时使用。
AESTUS_ADMIN_PASSWORD=change-me-admin-password
# 初始管理员的 token 总额度；仅创建管理员时生效，管理员已存在时不会重置额度。
AESTUS_ADMIN_INITIAL_QUOTA=1000000

# ==================== 注册邮件 ====================

# SMTP 服务器主机名；用于发送用户注册验证码，不能为空。
AESTUS_SMTP_HOST=smtp.example.com
# SMTP 服务器端口。默认 587 适用于 STARTTLS；应与邮件服务商提供的端口一致。
AESTUS_SMTP_PORT=587
# SMTP 登录用户名，不能为空。
AESTUS_SMTP_USERNAME=change-me-smtp-user
# SMTP 登录密码或应用专用密码，不能为空。
AESTUS_SMTP_PASSWORD=change-me-smtp-password
# 注册验证码邮件的 From 地址，必须是合法邮箱且通常需要经过 SMTP 服务商授权。
AESTUS_SMTP_FROM=no-reply@example.com
# 注册验证码有效期，单位为秒；600 秒等于 10 分钟。
AESTUS_EMAIL_CODE_TTL_SECONDS=600
# 同一邮箱再次发送注册验证码前的冷却时间，单位为秒。
AESTUS_EMAIL_CODE_COOLDOWN_SECONDS=60

# ==================== 网关通用配置 ====================

# PostgreSQL 连接池允许建立的最大连接数；应结合网关副本数和数据库连接上限设置。
AESTUS_DATABASE_POOL_SIZE=50
# 可重放请求体保留在内存中的阈值，单位为字节；超过阈值后改用临时文件缓存。
# 该值不是请求体大小上限；当前请求体硬上限由服务端固定为 64 MiB。
AESTUS_BODY_MEMORY_LIMIT_BYTES=1048576
# 单个下游请求在首次上游调用失败后允许的额外重试次数；2 表示最多发起 3 次上游调用。
AESTUS_UPSTREAM_RETRY_LIMIT=2
# 同一会话保持使用同一上游资源的 Redis 映射有效期，单位为秒。
AESTUS_PROVIDER_SESSION_STICKY_TTL_SECONDS=3600
# 调度时从同一 Provider 分组随机加载并参与评分的候选资源数量；最小有效值为 1。
AESTUS_PROVIDER_SCHEDULER_CANDIDATE_LIMIT=32
# 建立任意 Provider 上游 TCP/TLS 连接的超时时间，单位为秒。
AESTUS_PROVIDER_UPSTREAM_CONNECT_TIMEOUT_SECONDS=30
# 非流式上游请求从发送到完整响应结束的总超时时间，单位为秒。
AESTUS_PROVIDER_UPSTREAM_TIMEOUT_SECONDS=120
# 流式上游连续没有收到任何字节时的超时时间，单位为秒；0 表示禁用空闲超时。
# 该配置不会限制持续有数据返回的 SSE 响应总时长。
AESTUS_PROVIDER_UPSTREAM_STREAM_IDLE_TIMEOUT_SECONDS=0

# ==================== GPT 上游 ====================

# GPT 官方 API Key 资源的后台健康探测间隔，单位为秒。
AESTUS_GPT_UPSTREAM_API_KEY_PROBE_INTERVAL_SECONDS=120
# GPT OAuth 账号被判定为额度耗尽后再次尝试恢复的等待时间，单位为秒；18000 秒等于 5 小时。
AESTUS_GPT_QUOTA_RECOVERY_SECONDS=18000

# GPT OAuth 账号使用的 Codex 上游基础地址；一般无需修改。
AESTUS_GPT_UPSTREAM_BASE_URL=https://chatgpt.com/backend-api/codex
# GPT Responses 上游路径，会与对应资源的基础地址拼接。
AESTUS_GPT_UPSTREAM_RESPONSES_PATH=/responses
# GPT 图片生成上游路径，会与对应资源的基础地址拼接。
AESTUS_GPT_UPSTREAM_IMAGE_GENERATIONS_PATH=/images/generations
# GPT 图片编辑上游路径，会与对应资源的基础地址拼接。
AESTUS_GPT_UPSTREAM_IMAGE_EDITS_PATH=/images/edits

# GPT OAuth access token 到期前提前刷新的时间，单位为秒。
AESTUS_GPT_TOKEN_REFRESH_AHEAD_SECONDS=180
# GPT token 刷新发生非终态失败后的独立重试间隔，单位为秒；最小有效值为 1。
# 该值不影响普通模型请求遇到限流或上游 5xx 后的账号冷却时间。
AESTUS_GPT_TOKEN_REFRESH_RETRY_SECONDS=30
# GPT OAuth/OIDC 签发方地址，服务会基于该地址拼接 OAuth 授权端点；一般无需修改。
AESTUS_GPT_OAUTH_ISSUER=https://auth.openai.com
# GPT OAuth 回调地址，必须与实际发起授权的本地回调监听地址及上游登记值一致。
AESTUS_GPT_OAUTH_REDIRECT_URI=http://localhost:1455/auth/callback
# GPT OAuth 请求的权限范围，多个 scope 使用空格分隔；一般无需修改。
AESTUS_GPT_OAUTH_SCOPE=openid profile email offline_access
# GPT OAuth 临时授权会话的有效期，单位为秒；过期后必须重新发起授权。
AESTUS_GPT_OAUTH_SESSION_TTL_SECONDS=600
# GPT OAuth 使用授权码或 refresh token 换取 token 的端点；一般无需修改。
AESTUS_GPT_TOKEN_ENDPOINT=https://auth.openai.com/oauth/token
# Codex 请求缺少 version header 时注入的兜底版本值；留空表示不主动注入。
AESTUS_CODEX_VERSION_HEADER=

# ==================== Claude 上游 ====================

# Claude OAuth 账号遇到上游限流后暂停参与调度的时间，单位为秒。
AESTUS_CLAUDE_ACCOUNT_RATE_LIMIT_COOLDOWN_SECONDS=120
# Claude 官方 API Key 资源的后台健康探测间隔，单位为秒。
AESTUS_CLAUDE_UPSTREAM_API_KEY_PROBE_INTERVAL_SECONDS=120
# Claude 官方 API Key 健康探测请求使用的模型，必须是该 Key 有权访问的有效模型。
AESTUS_CLAUDE_UPSTREAM_API_KEY_PROBE_MODEL=claude-opus-4-8
# Claude 上游基础地址；OAuth 账号和未覆盖 Base URL 的官方 API Key 资源使用此值。
AESTUS_CLAUDE_UPSTREAM_BASE_URL=https://api.anthropic.com
# Claude Messages 上游路径，会与对应资源的基础地址拼接。
AESTUS_CLAUDE_UPSTREAM_MESSAGES_PATH=/v1/messages

# Claude OAuth access token 到期前提前刷新的时间，单位为秒。
AESTUS_CLAUDE_TOKEN_REFRESH_AHEAD_SECONDS=180
# Claude token 刷新发生非终态失败后的独立重试间隔，单位为秒；最小有效值为 1。
# 该值不影响普通模型请求遇到限流或上游 5xx 后的账号冷却时间。
AESTUS_CLAUDE_TOKEN_REFRESH_RETRY_SECONDS=30
# Claude OAuth 用户授权页面地址；一般无需修改。
AESTUS_CLAUDE_OAUTH_AUTHORIZE_URL=https://claude.com/cai/oauth/authorize
# Claude OAuth 回调地址，必须与上游 OAuth 客户端登记值一致。
AESTUS_CLAUDE_OAUTH_REDIRECT_URI=https://platform.claude.com/oauth/code/callback
# Claude OAuth 请求的权限范围，多个 scope 使用空格分隔；一般无需修改。
AESTUS_CLAUDE_OAUTH_SCOPE=user:profile user:inference user:sessions:claude_code user:mcp_servers user:file_upload
# Claude OAuth 临时授权会话的有效期，单位为秒；过期后必须重新发起授权。
AESTUS_CLAUDE_OAUTH_SESSION_TTL_SECONDS=600
# Claude OAuth 使用授权码或 refresh token 换取 token 的端点；一般无需修改。
AESTUS_CLAUDE_TOKEN_ENDPOINT=https://platform.claude.com/v1/oauth/token

# ==================== 日志 ====================

# 网关滚动日志文件名；文件写入容器 /app/logs，并由 Compose 挂载到 deploy/logs。
# 单个文件达到 2 MiB 时自动滚动，历史文件不会由应用自动删除。
AESTUS_LOG_FILE_NAME=aestus-gateway.log
# Rust tracing 日志过滤规则，格式为 target=level；可将具体模块调为 debug 以排查问题。
RUST_LOG=aestus=info,tower_http=info,axum=info
